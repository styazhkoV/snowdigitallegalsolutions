---
const pillars = [
  {
    id: 'fintech',
    title: '10+ лет в FinTech и банках',
    subtitle: 'Системный анализ в регулируемых средах',
    description: 'Опыт работы с крупными банками и финансовыми продуктами. Корневой анализ сбоев, проектирование REST API с учётом комплаенса и регуляторных требований.',
    benefit: 'Документ проектируется не как эмоциональное письмо, а как «карточка» в базе данных с точной атрибуцией.'
  },
  {
    id: 'sed',
    title: 'Понимание внутренней логики СЭД',
    subtitle: 'Жизненный цикл документа и маршрутизация',
    description: 'Практика работы с системами электронного документооборота, где у каждого обращения есть жесткие SLA, статус и зона ответственности конкретного исполнителя.',
    benefit: 'Исключается риск попадания документа «в непрофильный отдел» или на дальний склад.'
  },
  {
    id: 'appk',
    title: 'Практика фиксации по АППК РК',
    subtitle: 'Прямые нормы ст. 63 и ст. 91 АППК РК',
    description: 'Применение алгоритмов кодирования требований. Обращения содержат обязательные ссылки на персональную дисциплинарную ответственность чиновников.',
    benefit: 'Исполнитель видит правовые риски игнорирования и визирует обращение по существу.'
  }
];

const caseStudies = [
  {
    category: 'ЖКХ и благоустройство',
    problem: 'Акимат 4 месяца игнорировал обращения жителей по ремонту дороги, присылая отписки «бюджет не выделен».',
    solution: 'Спроектировано e-Doc обращение с переквалификацией в нарушение норм безопасности и указанием ст. 91 АППК РК.',
    result: 'Запрос взят на процессуальный контроль, инспекция выехала на место через 5 дней, ремонт включён в план Q3.'
  },
  {
    category: 'Споры с налоговой / УГД',
    problem: 'Формальная блокировка счёта ИП из-за расхождения в 1 200 ₸ при техническом сбое системы.',
    solution: 'Подготовлена административная жалоба вышестоящему руководству с детализацией логов и требованием снятия ареста.',
    result: 'Счёт разблокирован в течение 24 часов без штрафных санкций.'
  },
  {
    category: 'Отписка по ЦОН / Госуслугам',
    problem: 'Отказ в регистрации объекта недвижимости из-за опечатки оператора в первичном документе.',
    solution: 'Подано e-Doc заявление с правовым обоснованием обязательного устранения ошибки органом-эмитентом без повторной оплаты.',
    result: 'Ошибка исправлена за 2 дня, услуга оказана в полном объёме.'
  }
];
---

<section id="expertise" class="bg-slate-50 py-16 sm:py-20 lg:py-24" aria-labelledby="expertise-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="expertise-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
        На стыке системного анализа, FinTech и административных процедур
      </h2>
      <p class="mt-4 text-base text-slate-600 sm:text-lg">
        Инженерный подход к составлению документов: соединяем 10+ лет опыта в IT-архитектуре и нормы АППК РК.
      </p>
    </div>

    <!-- 3 Столпа -->
    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {pillars.map((item) => (
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md sm:p-8">
          <div>
            <span class="inline-block rounded-md bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">
              {item.subtitle}
            </span>
            <h3 class="mt-4 text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.description}</p>
          </div>
          <div class="mt-6 border-t border-slate-100 pt-4">
            <p class="text-xs font-semibold text-emerald-700 sm:text-sm">
              <span class="font-bold">Польза для вас:</span> {item.benefit}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Сравнение с обычным юристом -->
    <div class="mx-auto mt-12 max-w-4xl rounded-2xl border border-blue-200 bg-blue-50/60 p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-600 font-bold text-xl text-white">
          VS
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900">Почему системный подход эффективнее классического юриста?</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-700 sm:text-base">
            Обычный юрист пишет текст на 5–10 страниц со сложным слогом. Системный аналитик проектирует документ под алгоритмы государственной СЭД: <span class="font-semibold text-slate-900">точный адресат → структура по ст. 63 → ссылки на ст. 91 → лаконичный просительный блок</span>. Такой документ чиновник читает за 2 минуты и не может сбросить в архив.
          </p>
        </div>
      </div>
    </div>

    <!-- Практические кейсы -->
    <div class="mt-16">
      <h3 class="text-center text-xl font-bold text-slate-900 sm:text-2xl">
        Практика фиксации: анонимизированные кейсы
      </h3>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {caseStudies.map((c) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">{c.category}</span>
            <h4 class="mt-2 text-xs font-semibold text-red-700">Проблема:</h4>
            <p class="mt-1 text-xs text-slate-600">{c.problem}</p>
            <h4 class="mt-3 text-xs font-semibold text-blue-700">Решение e-Doc:</h4>
            <p class="mt-1 text-xs text-slate-600">{c.solution}</p>
            <div class="mt-3 rounded-lg border border-emerald-100 bg-emerald-50 p-2.5">
              <h4 class="text-xs font-bold text-emerald-800">Результат в СЭД:</h4>
              <p class="mt-0.5 text-xs text-emerald-700">{c.result}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>