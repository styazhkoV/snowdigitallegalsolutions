---
import { buildWhatsAppLink } from '../lib/messenger';

const phone = '77055606066';

const tariffs = [
  {
    id: 'basic_7500',
    title: 'Первичное системное обращение',
    tag: 'Базовый',
    price: '7 500 ₸',
    forWhom: 'ЖКХ, благоустройство, ЦОН, локальные нарушения, первичные запросы.',
    includes: [
      'Готовый e-Doc файл (PDF/Word до 3 стр.)',
      'Нормативная база (статьи АППК РК)',
      'Пошаговая инструкция по подаче через eGov Mobile'
    ],
    limitations: 'Только подготовка документа. Повторные жалобы не входят.',
    ctaText: 'Выбрать «Первичное обращение»',
    prefilledText: 'Здравствуйте! Меня интересует тариф «Первичное системное обращение» (7 500 ₸).',
    isPopular: false
  },
  {
    id: 'complex_15000',
    title: 'Сложная правовая жалоба',
    tag: 'Рекомендуем',
    price: '15 000 ₸',
    forWhom: 'Акиматы, Налоговая (УГД), банки, регуляторы, споры по FinTech.',
    includes: [
      'Глубокий правовой разбор ситуации',
      'Мотивированное обоснование и требования',
      'Оформление доказательной базы в e-Doc пакет',
      'Прямая адресация на руководящий состав СЭД'
    ],
    limitations: 'Объём приложений до 10 страниц.',
    ctaText: 'Заказать сложную жалобу',
    prefilledText: 'Здравствуйте! Меня интересует тариф «Сложная правовая жалоба» (15 000 ₸).',
    isPopular: true
  },
  {
    id: 'anti_otpiska_25000',
    title: 'Комплекс «Анти-Отписка»',
    tag: 'Специализированный',
    price: '25 000 ₸',
    forWhom: 'Уже получена отписка, формальный отказ или игнорирование.',
    includes: [
      'Анализ полученного ответа на предмет нарушений АППК',
      'Административная жалоба вышестоящему органу / прокуратуре',
      'Ссылки на персональную ответственность по ст. 91 АППК РК',
      'Шаблон повторного обращения в АДГС (при просрочках)'
    ],
    limitations: 'Один инцидент отписки.',
    ctaText: 'Обжаловать отписку',
    prefilledText: 'Здравствуйте! Меня интересует тариф «Анти-Отписка» (25 000 ₸).',
    isPopular: false
  }
];

const helpLink = buildWhatsAppLink(phone, 'Здравствуйте! Не могу определиться с тарифом, нужна помощь с выбором.');
---

<section id="tariffs" class="bg-slate-50 py-16 sm:py-20 lg:py-24" aria-labelledby="tariffs-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="tariffs-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
        Каталог e-Doc решений
      </h2>
      <p class="mt-4 text-base text-slate-600 sm:text-lg">
        Прозрачные тарифы. Фиксированная цена для типовых ситуаций без скрытых платежей.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3 lg:items-stretch">
      {tariffs.map((t) => {
        const href = buildWhatsAppLink(phone, t.prefilledText);
        return (
          <div class={`relative flex flex-col justify-between rounded-2xl bg-white p-6 sm:p-8 shadow-sm transition hover:shadow-md border ${t.isPopular ? 'border-emerald-500 ring-2 ring-emerald-500/20' : 'border-slate-200'}`}>
            {t.isPopular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-600 px-4 py-1 text-xs font-bold text-white shadow-xs">
                {t.tag}
              </span>
            )}
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-lg font-bold text-slate-900">{t.title}</h3>
                {!t.isPopular && (
                  <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">
                    {t.tag}
                  </span>
                )}
              </div>
              
              <div class="mt-4 flex items-baseline gap-1">
                <span class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{t.price}</span>
              </div>

              <div class="mt-6 border-t border-slate-100 pt-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Для кого:</p>
                <p class="mt-1 text-xs text-slate-600 leading-relaxed">{t.forWhom}</p>
              </div>

              <div class="mt-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Что входит:</p>
                <ul class="mt-2 space-y-2">
                  {t.includes.map((inc) => (
                    <li class="flex items-start gap-2 text-xs text-slate-700">
                      <span class="font-bold text-emerald-600">✓</span>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8">
              <p class="mb-4 text-[11px] text-slate-400">
                <span class="font-semibold text-slate-500">Ограничение:</span> {t.limitations}
              </p>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={`block w-full rounded-lg py-3 text-center text-xs font-bold transition ${t.isPopular ? 'bg-emerald-600 text-white hover:bg-emerald-700' : 'bg-slate-900 text-white hover:bg-slate-800'}`}
              >
                {t.ctaText}
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mx-auto mt-10 max-w-2xl rounded-xl border border-dashed border-emerald-300 bg-emerald-50/50 p-4 text-center">
      <p class="text-sm font-medium text-slate-700">
        Не знаете, какой тариф выбрать? 
        <a href={helpLink} target="_blank" rel="noopener noreferrer" class="ml-1 font-bold text-emerald-700 underline hover:text-emerald-800">
          Нажмите сюда — бесплатно разберём ваш случай в WhatsApp
        </a>
      </p>
    </div>
  </div>
</section>