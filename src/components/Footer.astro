---
import { buildWhatsAppLink, buildTelegramLink } from '../lib/messenger';

const phone = '77055606066';
const telegramUser = 'alexsandr_styazhkov';

const waHref = buildWhatsAppLink(phone, 'Здравствуйте! Хочу перевести проблему в официальный диалог через eOtinish.');
const tgHref = buildTelegramLink(telegramUser, 'Здравствуйте! Хочу перевести проблему в официальный диалог через eOtinish.');
---

<footer class="bg-slate-900 text-white pt-16 pb-12" aria-labelledby="footer-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Final CTA -->
    <div class="rounded-2xl border border-slate-700 bg-gradient-to-br from-slate-800 to-slate-900 p-8 text-center shadow-xl sm:p-12">
      <h2 id="footer-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">
        Готовы перевести переписку в официальный юридический диалог?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-300 sm:text-base">
        Напишите нам прямо сейчас. Оценим перспективы обращения и подготовим e-Doc файл в течение 1–3 часов.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-base font-bold text-white transition hover:bg-emerald-700 sm:w-auto"
        >
          Зафиксировать обращение в WhatsApp
        </a>

        <a
          href={tgHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[48px] w-full items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-bold text-white transition hover:bg-blue-700 sm:w-auto"
        >
          Написать в Telegram
        </a>
      </div>

      <div class="mt-6">
        <button
          id="kaspi-modal-open"
          type="button"
          class="text-xs font-semibold text-slate-400 underline hover:text-emerald-400"
        >
          Оплатить через Kaspi Pay (инструкция)
        </button>
      </div>
    </div>

    <!-- Футер инфо -->
    <div class="mt-16 border-t border-slate-800 pt-8 text-center text-xs text-slate-400 space-y-3">
      <p>ИП Стяжков А. А. · Республика Казахстан, г. Алматы</p>
      <p>
        <a href="/privacy-policy" class="underline hover:text-white">Политика конфиденциальности и обработки ПДн</a>
      </p>
      <p class="mx-auto max-w-3xl text-[11px] text-slate-500">
        Дисклеймер: Сервис предоставляет частные услуги по подготовке документов (e-Doc). Не является официальным сайтом, представительством или аффилированной структурой eGov.kz или СЭД eOtinish.kz. Ключи ЭЦП не запрашиваются и не принимаются.
      </p>
    </div>
  </div>
</footer>

<!-- Kaspi Pay Modal -->
<dialog id="kaspi-modal" class="max-w-md rounded-2xl bg-white p-6 shadow-2xl backdrop:bg-slate-900/60">
  <h3 class="text-lg font-bold text-slate-900">Оплата через Kaspi Pay</h3>
  <ol class="mt-4 space-y-3 text-xs text-slate-600">
    <li>1. Напишите нам в WhatsApp или Telegram для согласования деталей обращения.</li>
    <li>2. После подтверждения заказа эксперт отправляет ссылку на оплату в приложении Kaspi.kz.</li>
  </ol>
  <div class="mt-6 text-right">
    <button id="kaspi-modal-close" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white">
      Понятно
    </button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('kaspi-modal') as HTMLDialogElement | null;
  const openBtn = document.getElementById('kaspi-modal-open');
  const closeBtn = document.getElementById('kaspi-modal-close');

  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());
</script>