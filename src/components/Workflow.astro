---
const steps = [
  {
    num: '01',
    role: 'Клиент',
    time: '10–15 мин',
    title: 'Фиксация обращения',
    desc: 'Заполняете простой бриф или отправляете голосовое сообщение в WhatsApp: Что произошло? Когда? Какого результата хотите?'
  },
  {
    num: '02',
    role: 'Эксперт',
    time: '30–60 мин',
    title: 'Системный и правовой анализ',
    desc: 'Определяем точный госорган-адресат в СЭД и подбираем применимые статьи АППК РК для исключения формального отказа.'
  },
  {
    num: '03',
    role: 'Эксперт',
    time: '1–3 часа',
    title: 'Сборка e-Doc пакета',
    desc: 'Формируем структурированный файл с нормативным обоснованием, доказательной базой и жестким просительным блоком.'
  },
  {
    num: '04',
    role: 'Клиент',
    time: '2–5 мин',
    title: 'Подача в СЭД',
    desc: 'Вы получаете готовый e-Doc файл и инструкцию. Подписываете и отправляете его через eGov Mobile самостоятельно.'
  },
  {
    num: '05',
    role: 'Эксперт + Клиент',
    time: 'до 15 дней',
    title: 'Мониторинг SLA',
    desc: 'Отслеживаем статус обращения. В случае нарушения контрольного срока подготовка жалобы на просрочку включена.'
  }
];
---

<section id="workflow" class="bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="workflow-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="workflow-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
        Как устроена работа
      </h2>
      <p class="mt-4 text-base text-slate-600 sm:text-lg">
        Прозрачный и понятный процесс от вашей проблемы до официального входящего номера в eOtinish.
      </p>
    </div>

    <div class="mt-12 space-y-6 md:grid md:grid-cols-5 md:gap-4 md:space-y-0">
      {steps.map((step) => (
        <div class="relative flex flex-col justify-between rounded-xl border border-slate-200 bg-slate-50 p-5">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-extrabold text-emerald-600">{step.num}</span>
              <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase ${step.role === 'Клиент' ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800'}`}>
                {step.role}
              </span>
            </div>
            <h3 class="mt-3 text-sm font-bold text-slate-900">{step.title}</h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">{step.desc}</p>
          </div>
          <div class="mt-4 border-t border-slate-200 pt-2 text-[11px] font-medium text-slate-500">
            Срок: {step.time}
          </div>
        </div>
      ))}
    </div>

    <!-- Предупреждение про ЭЦП -->
    <div class="mx-auto mt-12 max-w-3xl rounded-xl border border-amber-200 bg-amber-50 p-4 text-center">
      <p class="text-xs font-semibold text-amber-900 sm:text-sm">
        ⚠️ <span class="font-bold uppercase">Важно:</span> Мы никогда не запрашиваем ваши ключи ЭЦП (`.p12`). Передавать ЭЦП третьим лицам запрещено законом РК. Вы отправляете файл сами за 2 минуты.
      </p>
    </div>
  </div>
</section>