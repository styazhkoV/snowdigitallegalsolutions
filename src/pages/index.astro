---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <!-- Сюда пойдут компоненты: Hero, ProblemComparison, Expertise и т.д. -->
    <section class="mx-auto max-w-6xl px-4 py-20">
      <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        Каркас лендинга eOtinish готов
      </h1>
      <p class="mt-4 text-slate-600">
        Tailwind подключён. Можно переходить к Итерации 1–2 (утилиты и Hero).
      </p>
      <a
        href="#"
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-emerald-600 px-6 py-3 text-white hover:bg-emerald-700"
      >
        Тестовая CTA-кнопка
      </a>
    </section>
  </main>
</Layout>